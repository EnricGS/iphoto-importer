<Window x:Class="iPhotoImporter.MiratSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Destins Mirat"
        Height="460" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBase}"
        FontFamily="Segoe UI Variable, Segoe UI"
        Foreground="{StaticResource TextPrimary}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Capçalera -->
            <RowDefinition Height="Auto"/>  <!-- Botó vincular -->
            <RowDefinition Height="Auto"/>  <!-- Títol llista -->
            <RowDefinition Height="*"/>     <!-- Llista destins -->
            <RowDefinition Height="Auto"/>  <!-- Separador -->
            <RowDefinition Height="Auto"/>  <!-- Peu -->
        </Grid.RowDefinitions>

        <!-- Capçalera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Destins Mirat" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Vincula iPhoto Manager amb el teu compte de Mirat per pujar fotos."
                       FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Botó primari de vinculació -->
        <Button Grid.Row="1" x:Name="ConnectMiratButton"
                Content="Vincular amb Mirat"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Padding="14,9" Margin="0,0,0,18"
                Background="{StaticResource Accent}"
                Foreground="{StaticResource TextOnAccent}"
                BorderThickness="0" FontSize="13" FontWeight="SemiBold"
                Click="ConnectMirat_Click"/>

        <!-- Títol llista -->
        <TextBlock Grid.Row="2" Text="Dispositius vinculats" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondary}" Margin="2,0,0,8"/>

        <!-- Llista destins existents / placeholder -->
        <Border Grid.Row="3" Background="{StaticResource BgSurface}" CornerRadius="8"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                Padding="4">
            <Grid>
                <!-- Placeholder quan no hi ha destins -->
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Cap destí configurat" FontSize="12" FontWeight="Medium"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Clica &quot;Vincular amb Mirat&quot; per començar."
                               FontSize="11" Foreground="{StaticResource TextDim}"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <ScrollViewer x:Name="DestinationsScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DestinationsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Margin="2,2"
                                        Background="{StaticResource BgCard}" CornerRadius="6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Eliminar"
                                                FontSize="10" Padding="8,3" Margin="6,0,0,0"
                                                Background="Transparent"
                                                Foreground="{StaticResource DangerColor}"
                                                BorderBrush="{StaticResource DangerColor}"
                                                BorderThickness="1"
                                                Click="RemoveDestination_Click"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock FontSize="10" Foreground="{StaticResource TextDim}">
                                                <Run Text="{Binding BaseUrl, Mode=OneWay}"/>
                                                <Run Text=" — "/>
                                                <Run Text="{Binding DisplayLabel, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Separador -->
        <Border Grid.Row="4" Height="1" Background="{StaticResource BorderSubtle}"
                Margin="0,12,0,12"/>

        <!-- Peu -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Tancar" Padding="14,7"
                    Background="Transparent"
                    Foreground="{StaticResource TextSecondary}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1" FontSize="12"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
