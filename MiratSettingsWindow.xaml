<Window x:Class="iPhotoImporter.MiratSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Destins Mirat"
        Height="620" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBase}"
        FontFamily="Segoe UI Variable, Segoe UI"
        Foreground="{StaticResource TextPrimary}">

    <Window.Resources>
        <!-- Duplicat dels recursos de MainWindow perquè cada Window té el seu propi
             scope de StaticResource. Canvis de tema cal fer-los a tots dos llocs. -->
        <SolidColorBrush x:Key="BgSurface" Color="#1C1A1F"/>
        <SolidColorBrush x:Key="BgElevated" Color="#252229"/>
        <SolidColorBrush x:Key="BgCard" Color="#2A2730"/>
        <SolidColorBrush x:Key="Accent" Color="#E8935A"/>
        <SolidColorBrush x:Key="AccentSubtle" Color="#2AE8935A"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0EDE8"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A8A0B0"/>
        <SolidColorBrush x:Key="TextDim" Color="#706878"/>
        <SolidColorBrush x:Key="TextOnAccent" Color="#1A1018"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#30FFFFFF"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#6ECB8B"/>
        <SolidColorBrush x:Key="DangerColor" Color="#E85A6F"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Capçalera -->
            <RowDefinition Height="Auto"/>  <!-- Llista destins existents -->
            <RowDefinition Height="Auto"/>  <!-- Separador -->
            <RowDefinition Height="*"/>     <!-- Formulari afegir/editar -->
            <RowDefinition Height="Auto"/>  <!-- Peu botons -->
        </Grid.RowDefinitions>

        <!-- Capçalera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Destins Mirat" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Configura on pujar fotos des d'iPhoto Manager. Pots tenir-ne diversos."
                       FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Llista destins existents -->
        <Border Grid.Row="1" Background="{StaticResource BgSurface}" CornerRadius="8"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                Padding="0" MinHeight="80" MaxHeight="150">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DestinationsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" Margin="4,3"
                                    Background="{StaticResource BgCard}" CornerRadius="6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Eliminar"
                                            FontSize="10" Padding="8,3" Margin="6,0,0,0"
                                            Background="Transparent"
                                            Foreground="{StaticResource DangerColor}"
                                            BorderBrush="{StaticResource DangerColor}"
                                            BorderThickness="1"
                                            Click="RemoveDestination_Click"/>
                                    <Button DockPanel.Dock="Right" Content="Editar"
                                            FontSize="10" Padding="8,3"
                                            Background="Transparent"
                                            Foreground="{StaticResource TextSecondary}"
                                            BorderBrush="{StaticResource BorderSubtle}"
                                            BorderThickness="1"
                                            Click="EditDestination_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock FontSize="10" Foreground="{StaticResource TextDim}">
                                            <Run Text="{Binding BaseUrl, Mode=OneWay}"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding DisplayLabel, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Separador -->
        <TextBlock Grid.Row="2" Text="Afegir o editar destí" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondary}" Margin="2,18,0,10"/>

        <!-- Formulari -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="URL base del servidor" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <TextBox x:Name="BaseUrlInput" Text="https://www.miratfotos.com"
                         Padding="8,6" FontSize="12" Margin="0,0,0,12"
                         Background="{StaticResource BgSurface}"
                         Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderSubtle}"/>

                <TextBlock Text="API Key (X-API-Key)" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="ApiKeyInput"
                             Padding="8,6" FontSize="12" Margin="0,0,0,12"
                             Background="{StaticResource BgSurface}"
                             Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource BorderSubtle}"/>

                <Button x:Name="ConnectButton" Content="Provar connexió"
                        Padding="14,7" HorizontalAlignment="Left"
                        Background="{StaticResource Accent}"
                        Foreground="{StaticResource TextOnAccent}"
                        BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                        Margin="0,0,0,14" Click="Connect_Click"/>

                <TextBlock Text="Grup" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <ComboBox x:Name="GrupCombo" Padding="8,6" FontSize="12" Margin="0,0,0,12"
                          Background="{StaticResource BgSurface}"
                          Foreground="{StaticResource TextPrimary}"
                          IsEnabled="False"
                          DisplayMemberPath="Nom"
                          SelectionChanged="Grup_SelectionChanged"/>

                <TextBlock Text="Àlbum (opcional)" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <ComboBox x:Name="AlbumCombo" Padding="8,6" FontSize="12" Margin="0,0,0,12"
                          Background="{StaticResource BgSurface}"
                          Foreground="{StaticResource TextPrimary}"
                          IsEnabled="False"
                          DisplayMemberPath="Nom"/>

                <TextBlock Text="Nom descriptiu" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <TextBox x:Name="NomInput"
                         Padding="8,6" FontSize="12" Margin="0,0,0,6"
                         Background="{StaticResource BgSurface}"
                         Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderSubtle}"/>
                <TextBlock Text="Ex: &quot;Família Gardela / Vacances 2026&quot;"
                           FontSize="10" Foreground="{StaticResource TextDim}" Margin="0,0,0,12"/>

                <TextBlock x:Name="StatusText" FontSize="11" Margin="0,4,0,0"
                           TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Peu botons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancel·lar" Padding="14,7" Margin="0,0,8,0"
                    Background="Transparent"
                    Foreground="{StaticResource TextSecondary}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1" FontSize="12"
                    Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Content="Desar destí"
                    Padding="14,7" Background="{StaticResource Accent}"
                    Foreground="{StaticResource TextOnAccent}"
                    BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                    IsEnabled="False" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
