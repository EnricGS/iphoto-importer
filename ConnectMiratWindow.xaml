<Window x:Class="iPhotoImporter.ConnectMiratWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vincular amb Mirat"
        Height="460" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBase}"
        FontFamily="Segoe UI Variable, Segoe UI"
        Foreground="{StaticResource TextPrimary}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Capçalera -->
            <RowDefinition Height="*"/>     <!-- Contingut segons estat -->
            <RowDefinition Height="Auto"/>  <!-- Separador -->
            <RowDefinition Height="Auto"/>  <!-- Peu -->
        </Grid.RowDefinitions>

        <!-- Capçalera -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Vincular amb Mirat" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Connecta Photo Manager amb el teu compte de Mirat."
                       FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Contingut -->
        <Grid Grid.Row="1">

            <!-- Estat: esperant -->
            <StackPanel x:Name="WaitingPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="WaitingHint" Text="Demanant codi al servidor..."
                           FontSize="12" Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <Border x:Name="UserCodeBox" Visibility="Collapsed"
                        Background="{StaticResource BgSurface}" CornerRadius="10"
                        Padding="24,10" HorizontalAlignment="Center">
                    <TextBlock x:Name="UserCodeText" FontFamily="Consolas"
                               FontSize="36" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                </Border>

                <TextBlock x:Name="BrowserHint" Visibility="Collapsed"
                           Text="Inicia sessió a Mirat al navegador i confirma aquest codi. Si el navegador no s'ha obert (o l'has tancat):"
                           FontSize="11" Foreground="{StaticResource TextSecondary}"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Margin="20,14,20,0"/>

                <Button x:Name="OpenBrowserButton" Visibility="Collapsed"
                        Padding="14,7" Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Background="{StaticResource Accent}"
                        Foreground="{StaticResource TextOnAccent}"
                        BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                        Click="OpenBrowserButton_Click"
                        Content="Obrir el navegador"/>

                <TextBlock x:Name="VerificationUrlText" Visibility="Collapsed"
                           FontSize="11" Foreground="{StaticResource Accent}"
                           TextDecorations="Underline"
                           HorizontalAlignment="Center" Cursor="Hand"
                           MouseLeftButtonUp="VerificationUrl_Click"
                           Margin="0,6,0,0"/>

                <StackPanel x:Name="PollingIndicator" Visibility="Collapsed"
                            Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,18,0,0">
                    <ProgressBar IsIndeterminate="True" Width="16" Height="16"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource Accent}"/>
                    <TextBlock Text="Esperant autorització..." Margin="8,0,0,0"
                               FontSize="11" Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Estat: èxit -->
            <StackPanel x:Name="SuccessPanel" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                           FontSize="48" HorizontalAlignment="Center"
                           Foreground="{StaticResource SuccessColor}"/>
                <TextBlock Text="Dispositiu vinculat" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock x:Name="SuccessUserText" FontSize="12"
                           Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <TextBlock x:Name="SuccessGrupText" FontSize="11"
                           Foreground="{StaticResource TextDim}"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <TextBlock Text="Ja pots tancar aquesta finestra i començar a pujar fotos."
                           FontSize="11" Foreground="{StaticResource TextDim}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="20,12,20,0"/>
            </StackPanel>

            <!-- Estat: error -->
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xEB90;" FontFamily="Segoe MDL2 Assets"
                           FontSize="48" HorizontalAlignment="Center"
                           Foreground="{StaticResource DangerColor}"/>
                <TextBlock Text="No s'ha pogut vincular" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock x:Name="ErrorMessageText" FontSize="11"
                           Foreground="{StaticResource TextSecondary}"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Margin="20,6,20,0"/>
                <Button x:Name="RetryButton" Content="Tornar a provar"
                        Padding="14,7" Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Background="{StaticResource Accent}"
                        Foreground="{StaticResource TextOnAccent}"
                        BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                        Click="Retry_Click"/>
            </StackPanel>
        </Grid>

        <!-- Separador -->
        <Border Grid.Row="2" Height="1" Background="{StaticResource BorderSubtle}"
                Margin="0,12,0,12"/>

        <!-- Peu -->
        <DockPanel Grid.Row="3">
            <TextBlock DockPanel.Dock="Left" Text="Necessites ajuda per vincular?"
                       FontSize="11" Foreground="{StaticResource TextDim}"
                       TextDecorations="Underline" Cursor="Hand"
                       VerticalAlignment="Center"
                       MouseLeftButtonUp="HelpLink_Click"
                       ToolTip="Obre la guia de vinculació al navegador"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" Content="Cancel·lar" Padding="14,7"
                        Background="Transparent"
                        Foreground="{StaticResource TextSecondary}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1" FontSize="12"
                        Click="Close_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
