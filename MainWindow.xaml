<Window x:Class="iPhotoImporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:iPhotoImporter.ViewModels"
        Title="iPhoto Importer"
        Height="700" Width="1050"
        MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Converter per mostrar mida en format llegible -->
        <vm:MonthYearConverter x:Key="MonthYearConverter"/>

        <!-- Estil base dels botons -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#2979FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== BARRA SUPERIOR ==================== -->
        <Border Grid.Row="0" Background="White" Padding="16,12"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Títol -->
                <TextBlock DockPanel.Dock="Left" Text="iPhoto Importer"
                           FontSize="18" FontWeight="SemiBold" Foreground="#333"
                           VerticalAlignment="Center" Margin="0,0,24,0"/>

                <!-- Indicador de connexió -->
                <Ellipse DockPanel.Dock="Left" Width="10" Height="10"
                         VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#E53935"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedDevice, Converter={x:Static vm:NullToBoolConverter.Instance}}" Value="True">
                                    <Setter Property="Fill" Value="#43A047"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- Botó actualitzar -->
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource BtnSecondary}"
                        Command="{Binding RefreshDevicesCommand}"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Actualitzar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Botó carregar fotos -->
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource BtnSecondary}"
                        Command="{Binding LoadPhotosCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Carregar fotos" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- ComboBox dispositius -->
                <ComboBox ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="FriendlyName"
                          VerticalAlignment="Center"
                          FontSize="13" Padding="8,6"
                          MinWidth="200" Margin="0,0,12,0">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
            </DockPanel>
        </Border>

        <!-- ==================== CONTINGUT PRINCIPAL ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== PANELL ESQUERRE ========== -->
            <Border Grid.Column="0" Background="White" Padding="16"
                    BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Barra de progrés i botó principal a baix -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <ProgressBar Value="{Binding CopyProgress}" Minimum="0" Maximum="100"
                                     Height="6" Foreground="#2979FF" Background="#E0E0E0"
                                     BorderThickness="0" Margin="0,0,0,8"
                                     Visibility="{Binding IsCopying, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}"/>
                        <Button Content="Copiar seleccionades"
                                Style="{StaticResource BtnPrimary}"
                                Command="{Binding CopySelectedCommand}"
                                Height="42"/>
                    </StackPanel>

                    <StackPanel>
                        <!-- Resum selecció -->
                        <TextBlock Text="Selecció" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#555" Margin="0,0,0,12"/>

                        <Border Background="#F8F9FA" CornerRadius="6" Padding="14,12" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Fotos:" Foreground="#777"/>
                                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                               FontWeight="SemiBold" Foreground="#333">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} / {1}">
                                                <Binding Path="SelectedPhotosCount"/>
                                                <Binding Path="Photos.Count"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Mida:" Foreground="#777"/>
                                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                               FontWeight="SemiBold" Foreground="#333"
                                               Text="{Binding TotalSelectedSizeMB, StringFormat={}{0:N1} MB}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Botons selecció -->
                        <Button Content="Seleccionar totes"
                                Style="{StaticResource BtnSecondary}"
                                Command="{Binding SelectAllCommand}"
                                HorizontalAlignment="Stretch" Margin="0,4"/>
                        <Button Content="Desseleccionar totes"
                                Style="{StaticResource BtnSecondary}"
                                Command="{Binding DeselectAllCommand}"
                                HorizontalAlignment="Stretch" Margin="0,4"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ========== ZONA PRINCIPAL: GRAELLA DE FOTOS ========== -->
            <ListBox Grid.Column="1"
                     ItemsSource="{Binding PhotosView}"
                     SelectionMode="Single"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">

                <!-- Layout: WrapPanel dins ScrollViewer -->
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <!-- Capçalera de grup (mes/any) -->
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#444" Margin="8,16,8,6"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>

                <!-- Estil per eliminar la selecció visual del ListBox -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <!-- Template de cada foto -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="158" Background="White" CornerRadius="6"
                                BorderBrush="#E0E0E0" BorderThickness="1"
                                Padding="4" Margin="0"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{x:Static vm:ToggleSelectionCommand.Instance}"
                                              CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <StackPanel>
                                <!-- Miniatura amb checkbox superposat -->
                                <Grid Height="150" Width="150">
                                    <!-- Miniatura o placeholder -->
                                    <Border Background="#F0F0F0" CornerRadius="4">
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,150,150" RadiusX="4" RadiusY="4"/>
                                            </Image.Clip>
                                        </Image>
                                    </Border>
                                    <!-- Icona placeholder quan no hi ha miniatura -->
                                    <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="32" Foreground="#CCC"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Checkbox -->
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                              Margin="6,6,0,0">
                                        <CheckBox.LayoutTransform>
                                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                        </CheckBox.LayoutTransform>
                                    </CheckBox>
                                </Grid>
                                <!-- Info del fitxer -->
                                <TextBlock Text="{Binding FileName}" FontSize="11"
                                           Foreground="#555" Margin="2,4,2,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                <TextBlock Text="{Binding DateTaken, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                           FontSize="10" Foreground="#999" Margin="2,1,2,2"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Missatge quan no hi ha fotos -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding Photos.Count, Converter={x:Static vm:ZeroToVisibilityConverter.Instance}}">
                <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets"
                           FontSize="48" Foreground="#CCC" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Prem &quot;Actualitzar&quot; per detectar dispositius"
                           FontSize="14" Foreground="#999" HorizontalAlignment="Center"/>
                <TextBlock Text="i després &quot;Carregar fotos&quot; per veure'les aquí."
                           FontSize="13" Foreground="#BBB" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Spinner de càrrega -->
            <Border Grid.Column="1" Background="#80FFFFFF"
                    Visibility="{Binding IsLoading, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4"
                                 Foreground="#2979FF" Background="#E0E0E0" BorderThickness="0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#555"
                               FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== BARRA D'ESTAT ==================== -->
        <Border Grid.Row="2" Background="White" Padding="16,8"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#777"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Foreground" Value="#E53935"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</Window>
