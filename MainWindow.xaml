<Window x:Class="iPhotoImporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:iPhotoImporter.ViewModels"
        xmlns:conv="clr-namespace:iPhotoImporter.Converters"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        Title="Photo Manager"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBase}"
        FontFamily="Segoe UI Variable, Segoe UI"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Converters -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVis"/>
        <conv:PositiveToVisibilityConverter x:Key="PosToVis"/>
        <conv:FileSizeConverter x:Key="FileSizeConv"/>
        <conv:NullToBoolConverter x:Key="NullToBool"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- ============ PALETA MODERNA (warm dark theme) ============ -->
        <!-- Fons -->
        <SolidColorBrush x:Key="BgBase" Color="#141216"/>
        <SolidColorBrush x:Key="BgSurface" Color="#1C1A1F"/>
        <SolidColorBrush x:Key="BgElevated" Color="#252229"/>
        <SolidColorBrush x:Key="BgCard" Color="#2A2730"/>
        <SolidColorBrush x:Key="BgHover" Color="#352F3A"/>
        <SolidColorBrush x:Key="BgOverlay" Color="#F0141216"/>

        <!-- Accent (warm amber/terracotta) -->
        <SolidColorBrush x:Key="Accent" Color="#E8935A"/>
        <SolidColorBrush x:Key="AccentLight" Color="#F0A870"/>
        <SolidColorBrush x:Key="AccentDim" Color="#B06830"/>
        <SolidColorBrush x:Key="AccentSubtle" Color="#2AE8935A"/>

        <!-- Text -->
        <SolidColorBrush x:Key="TextPrimary" Color="#F0EDE8"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A8A0B0"/>
        <SolidColorBrush x:Key="TextDim" Color="#706878"/>
        <SolidColorBrush x:Key="TextOnAccent" Color="#1A1018"/>

        <!-- Vores i separadors -->
        <SolidColorBrush x:Key="BorderSubtle" Color="#30FFFFFF"/>
        <SolidColorBrush x:Key="BorderMedium" Color="#40FFFFFF"/>

        <!-- Semàntics -->
        <SolidColorBrush x:Key="SuccessColor" Color="#6ECB8B"/>
        <SolidColorBrush x:Key="DangerColor" Color="#E85A6F"/>
        <SolidColorBrush x:Key="HighlightBorder" Color="#E8935A"/>
        <SolidColorBrush x:Key="SelectedBorder" Color="#E8935A"/>

        <!-- ============ ESTILS BASE ============ -->

        <!-- Botó base modern -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnToolbar" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource BgElevated}"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource TextOnAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentDim}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource DangerColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botó icona (circular/compacte) -->
        <Style x:Key="BtnIcon" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botó toolbar icon-only (sense text, per a la barra superior) -->
        <Style x:Key="BtnToolbarIcon" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource BgElevated}"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <!-- Botó toolbar primary icon-only -->
        <Style x:Key="BtnPrimaryIcon" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <!-- ToggleButton per filtre (estil pill) -->
        <Style x:Key="BtnFilterToggle" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentSubtle}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentDim}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgHover}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentSubtle}"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider modern -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>

        <!-- Estil nav button (semitransparent, arrodonit) -->
        <Style x:Key="BtnNav" TargetType="Button">
            <Setter Property="Background" Value="#40000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                                <Setter TargetName="border" Property="Background" Value="#60000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Window.InputBindings>
        <!-- Ctrl+Z desfà el darrer delete (restaura de la paperera) -->
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoLastDeleteCommand}"/>
        <KeyBinding Key="F1" Command="{Binding ToggleHelpOverlayCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Barra superior -->
            <RowDefinition Height="*"/>      <!-- Contingut principal -->
            <RowDefinition Height="Auto"/>  <!-- Barra d'estat -->
        </Grid.RowDefinitions>

        <!-- ==================== BARRA SUPERIOR ==================== -->
        <Border Grid.Row="0" Background="{StaticResource BgSurface}" Padding="16,10"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Logotip i títol -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border Background="{StaticResource AccentSubtle}" CornerRadius="8" Padding="6" Margin="0,0,10,0">
                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Photo Manager"
                               FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" Opacity="0.9"/>
                </StackPanel>

                <!-- Toolbar superior (ordre macOS: scan disc, add folder, folders, destí, iPhone) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BgElevated}" CornerRadius="8" Padding="2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <!-- 1. Escanejar disc (macOS: desktopcomputer) -->
                            <Button Style="{StaticResource BtnToolbarIcon}"
                                    Command="{Binding ToggleDiskScanPanelCommand}"
                                    ToolTip="Escanejar disc per trobar fotos">
                                <TextBlock Text="&#xE7F8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </Button>

                            <!-- 2. Afegir carpeta -->
                            <Button Style="{StaticResource BtnToolbarIcon}"
                                    Command="{Binding OpenFolderCommand}"
                                    ToolTip="Afegir carpeta d'origen (Ctrl+O)">
                                <TextBlock Text="📁" FontFamily="Segoe UI Emoji" FontSize="15"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Botó netejar tot (visible quan hi ha carpetes) -->
                    <Button Style="{StaticResource BtnIcon}" Padding="6,5"
                            Command="{Binding ClearAllFoldersCommand}"
                            ToolTip="Netejar totes les carpetes"
                            Visibility="{Binding OpenFolderCount, Converter={StaticResource PosToVis}}"
                            Margin="0,0,6,0">
                        <TextBlock Text="&#xE894;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" Foreground="{StaticResource TextDim}"/>
                    </Button>

                    <!-- Separador visual -->
                    <Border Width="1" Height="20" Background="{StaticResource BorderSubtle}" Margin="2,0,8,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding OpenFolderCount, Converter={StaticResource PosToVis}}"/>

                    <!-- Llista de carpetes obertes -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding OpenFolderCount, Converter={StaticResource PosToVis}}">
                        <TextBlock Text="📁" FontFamily="Segoe UI Emoji" FontSize="11"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ItemsControl ItemsSource="{Binding OpenFolders}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgElevated}" CornerRadius="6"
                                            Padding="8,3" Margin="0,0,4,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       FontSize="10" VerticalAlignment="Center"
                                                       MaxWidth="160" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding}"/>
                                            <!-- Toggle recursiu -->
                                            <Button Style="{StaticResource BtnIcon}" Padding="3,1"
                                                    Command="{Binding DataContext.ToggleRecursiveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Alternar escaneig recursiu" Margin="4,0,0,0">
                                                <TextBlock Text="📁" FontFamily="Segoe UI Emoji"
                                                           FontSize="9" Foreground="{StaticResource TextDim}"/>
                                            </Button>
                                            <Button Style="{StaticResource BtnIcon}" Padding="3,1"
                                                    Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Treure carpeta" Margin="2,0,0,0">
                                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="8" Foreground="{StaticResource TextDim}"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Separador + Destí -->
                    <Border Width="1" Height="20" Background="{StaticResource BorderSubtle}" Margin="6,0,8,0"
                            VerticalAlignment="Center"/>

                    <!-- Botó carpeta destí -->
                    <Button Style="{StaticResource BtnToolbarIcon}"
                            Command="{Binding SetDestinationFolderCommand}"
                            ToolTip="Definir carpeta de destí per copies" Margin="0,0,4,0">
                        <TextBlock Text="📁" FontFamily="Segoe UI Emoji" FontSize="15"
                                   Foreground="{StaticResource SuccessColor}"/>
                    </Button>

                    <!-- Indicador carpeta desti -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding HasDestinationFolder, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding DestinationFolder}"
                                   Foreground="{StaticResource SuccessColor}" FontSize="11" FontStyle="Italic"
                                   VerticalAlignment="Center" Margin="0,0,4,0"
                                   MaxWidth="180" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DestinationFolder}"/>
                        <Button Style="{StaticResource BtnIcon}" Padding="4,2"
                                Command="{Binding ClearDestinationFolderCommand}"
                                ToolTip="Treure carpeta de destí">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10" Foreground="{StaticResource TextDim}"/>
                        </Button>
                    </StackPanel>

                    <!-- Destí Mirat (api externa miratfotos.com / self-hosted) -->
                    <Button Style="{StaticResource BtnToolbarIcon}"
                            Click="OpenMiratSettings_Click"
                            ToolTip="Configurar destins Mirat" Margin="6,0,4,0">
                        <TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{StaticResource Accent}"/>
                    </Button>

                    <!-- Selector destí Mirat actiu -->
                    <ComboBox ItemsSource="{Binding MiratDestinations}"
                              SelectedItem="{Binding ActiveMiratDestination, Mode=TwoWay}"
                              DisplayMemberPath="Nom"
                              MinWidth="140" MaxWidth="200"
                              FontSize="11" Padding="6,3"
                              VerticalAlignment="Center" Margin="0,0,4,0"
                              ToolTip="Destí actiu per Copiar/Moure. Quan n'hi ha un seleccionat, Copiar/Moure pugen a Mirat en lloc de la carpeta local."
                              Visibility="{Binding MiratDestinations.Count, Converter={StaticResource PosToVis}}"/>

                    <!-- Desactivar destí Mirat (tornar a usar carpeta local) -->
                    <Button Style="{StaticResource BtnIcon}" Padding="4,2"
                            Command="{Binding SelectMiratDestinationCommand}"
                            CommandParameter="{x:Null}"
                            ToolTip="Desactivar destí Mirat"
                            Visibility="{Binding HasActiveMiratDestination, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="10" Foreground="{StaticResource TextDim}"/>
                    </Button>

                    <!-- Botó iPhone import -->
                    <Border Width="1" Height="20" Background="{StaticResource BorderSubtle}" Margin="6,0,8,0"
                            VerticalAlignment="Center"/>
                    <Button Style="{StaticResource BtnToolbarIcon}"
                            Command="{Binding ToggleImportPanelCommand}"
                            ToolTip="Importar des de dispositiu MTP (iPhone)">
                        <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </Button>

                    <!-- Ajuda: dreceres i gestos (F1) -->
                    <Button Style="{StaticResource BtnToolbarIcon}"
                            Command="{Binding ToggleHelpOverlayCommand}"
                            ToolTip="Dreceres i gestos (F1)" Margin="6,0,0,0">
                        <TextBlock Text="&#xE897;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== CONTINGUT PRINCIPAL ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="GridColumn" Width="*"/>
                <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="ViewerColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== GRAELLA DE MINIATURES ==================== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Botons split/import -->
                    <RowDefinition Height="Auto"/>  <!-- Controls de graella -->
                    <RowDefinition Height="*"/>      <!-- Miniatures -->
                    <RowDefinition Height="Auto"/>  <!-- Barra d'accions -->
                </Grid.RowDefinitions>

                <!-- Banner browse mode dispositiu -->
                <Border Grid.Row="0" Background="{StaticResource AccentSubtle}" Padding="12,8"
                        BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,1"
                        Visibility="{Binding IsDeviceBrowseMode, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" Padding="8,4"
                                Command="{Binding ExitDeviceBrowseModeCommand}"
                                ToolTip="Sortir del mode dispositiu">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12" Foreground="{StaticResource Accent}"/>
                        </Button>
                        <!-- Botó carregar més (visible quan NO està carregant) -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnToolbar}" Padding="8,4" Margin="0,0,8,0"
                                Command="{Binding LoadMoreFromDeviceCommand}"
                                ToolTip="Per anar ràpid només es carreguen els mesos més recents; cada clic carrega un mes més enrere"
                                Visibility="{Binding IsBrowsingDevice, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock FontSize="11" Foreground="{StaticResource Accent}">
                                <Run Text="+ Mes anterior"/>
                            </TextBlock>
                        </Button>
                        <!-- Spinner + missatge mentre carrega -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0"
                                    Visibility="{Binding IsBrowsingDevice, Converter={StaticResource BoolToVis}}">
                            <ProgressBar IsIndeterminate="True" Width="60" Height="3"
                                         Foreground="{StaticResource Accent}"
                                         Background="{StaticResource BgElevated}" BorderThickness="0"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ImportStatusMessage}" FontSize="10"
                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                <Run Text="Navegant:"/>
                                <Run Text="{Binding BrowseDeviceName, Mode=OneWay}"/>
                                <Run Text="—"/>
                                <Run Text="{Binding DeviceFileCount, Mode=OneWay}"/>
                                <Run Text="fitxers"/>
                            </TextBlock>
                            <TextBlock Text="· es carreguen només els mesos recents"
                                       FontSize="10" Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                       ToolTip="Per anar ràpid, del dispositiu només es carreguen els mesos més recents. Amplia amb «+ Mes anterior»."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Barra de controls de graella (ordre macOS: comptador, filtres, select, sort, split, timeline, slider, duplicats) -->
                <Border Grid.Row="1" Background="{StaticResource BgSurface}" Padding="12,8"
                        BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
                        Visibility="{Binding Photos.Count, Converter={StaticResource PosToVis}}">
                    <StackPanel Orientation="Horizontal">

                        <!-- 1. Comptador elements -->
                        <TextBlock Foreground="{StaticResource TextDim}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Run Text="{Binding Photos.Count, Mode=OneWay}" Foreground="{StaticResource TextSecondary}"/>
                            <Run Text=" elements"/>
                        </TextBlock>

                        <!-- 2. Filtre fotos/vídeos (pill) -->
                        <Border Background="{StaticResource BgElevated}" CornerRadius="8" Padding="2" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="FilterPhotosToggle"
                                              IsChecked="{Binding FilterPhotos}"
                                              Style="{StaticResource BtnFilterToggle}"
                                              ToolTip="Mostrar fotos">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock VerticalAlignment="Center" FontSize="11">
                                            <Run Text="{Binding PhotoCount, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </ToggleButton>
                                <Border Width="1" Height="14" Background="{StaticResource BorderSubtle}" VerticalAlignment="Center"/>
                                <ToggleButton x:Name="FilterVideosToggle"
                                              IsChecked="{Binding FilterVideos}"
                                              Style="{StaticResource BtnFilterToggle}"
                                              ToolTip="Mostrar vídeos">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock VerticalAlignment="Center" FontSize="11">
                                            <Run Text="{Binding VideoCount, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </Border>

                        <!-- 3. Select all / Deselect -->
                        <Border Background="{StaticResource BgElevated}" CornerRadius="8" Padding="2" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BtnIcon}"
                                        Command="{Binding SelectAllCommand}" ToolTip="Seleccionar tot (Ctrl+A)" Padding="6,4">
                                    <TextBlock Text="&#xE73A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="12" Foreground="{StaticResource TextPrimary}"/>
                                </Button>
                                <Button Style="{StaticResource BtnIcon}"
                                        Command="{Binding DeselectAllCommand}" ToolTip="Desseleccionar tot (Ctrl+D)" Padding="6,4">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="12" Foreground="{StaticResource TextPrimary}"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 4. Sort order toggle -->
                        <Button Style="{StaticResource BtnIcon}"
                                Command="{Binding ToggleSortOrderCommand}"
                                ToolTip="Canviar ordre (data)" Padding="6,4" Margin="0,0,4,0">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource TextPrimary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE74B;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SortAscending}" Value="True">
                                                <Setter Property="Text" Value="&#xE74A;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>

                        <!-- 5. Split/Toggle view mode -->
                        <Button Style="{StaticResource BtnIcon}"
                                Command="{Binding ToggleViewModeCommand}"
                                ToolTip="Canviar mode de visualització (Tab / F5)" Padding="6,4" Margin="0,0,4,0">
                            <TextBlock Text="&#xE145;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </Button>

                        <!-- 6. Grid/Timeline toggle + agrupació -->
                        <ToggleButton IsChecked="{Binding IsTimelineMode}"
                                      Style="{StaticResource BtnFilterToggle}"
                                      ToolTip="Mode timeline" Margin="0,0,4,0">
                            <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" VerticalAlignment="Center"/>
                        </ToggleButton>

                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                                    Visibility="{Binding IsTimelineMode, Converter={StaticResource BoolToVis}}">
                            <Border Background="{StaticResource BgElevated}" CornerRadius="6" Padding="1">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource BtnIcon}" Padding="5,3"
                                            Command="{Binding SetTimelineGroupingCommand}" CommandParameter="Day"
                                            ToolTip="Agrupar per dia">
                                        <TextBlock Text="D" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </Button>
                                    <Button Style="{StaticResource BtnIcon}" Padding="5,3"
                                            Command="{Binding SetTimelineGroupingCommand}" CommandParameter="Month"
                                            ToolTip="Agrupar per mes">
                                        <TextBlock Text="M" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </Button>
                                    <Button Style="{StaticResource BtnIcon}" Padding="5,3"
                                            Command="{Binding SetTimelineGroupingCommand}" CommandParameter="Year"
                                            ToolTip="Agrupar per any">
                                        <TextBlock Text="A" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 7. Slider mida thumbnails -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="&#xF0E2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider Value="{Binding ThumbnailSize}" Minimum="80" Maximum="400"
                                    Width="100" VerticalAlignment="Center"
                                    ToolTip="Mida de les miniatures"
                                    Style="{StaticResource ModernSlider}"/>
                            <TextBlock Text="&#xF0E2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <!-- 8. Duplicats exactes -->
                        <Border Background="{StaticResource BgElevated}" CornerRadius="8" Padding="2" Margin="0,0,4,0"
                                Visibility="{Binding ExactDuplicateCount, Converter={StaticResource PosToVis}}">
                            <ToggleButton IsChecked="{Binding FilterExactDuplicates}"
                                          Style="{StaticResource BtnFilterToggle}"
                                          ToolTip="Duplicats exactes">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="=" FontSize="13" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="11">
                                        <Run Text="{Binding ExactDuplicateCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </ToggleButton>
                        </Border>

                        <!-- 9. Duplicats similars -->
                        <Border Background="{StaticResource BgElevated}" CornerRadius="8" Padding="2"
                                Visibility="{Binding SimilarDuplicateCount, Converter={StaticResource PosToVis}}">
                            <ToggleButton IsChecked="{Binding FilterSimilarDuplicates}"
                                          Style="{StaticResource BtnFilterToggle}"
                                          ToolTip="Duplicats similars">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="≈" FontSize="13" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="11">
                                        <Run Text="{Binding SimilarDuplicateCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </ToggleButton>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- Graella de miniatures amb canvas overlay per selecció amb arrossegament -->
                <Grid Grid.Row="2"
                      Visibility="{Binding IsTimelineMode, Converter={StaticResource InvBoolToVis}}">
                    <ListBox ItemsSource="{Binding Photos}"
                             MouseRightButtonDown="ThumbnailArea_MouseRightButtonDown"
                             PreviewMouseLeftButtonDown="ThumbnailArea_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="ThumbnailArea_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="ThumbnailArea_PreviewMouseLeftButtonUp"
                             x:Name="PhotoGrid"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.CacheLength="2"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             Background="{StaticResource BgBase}" BorderThickness="0"
                             Margin="8,8,8,8"
                             Focusable="False">
                        <!-- Desactivar selecció visual nativa del ListBox -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <vwp:VirtualizingWrapPanel SpacingMode="Uniform" Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ThumbBorder"
                                        Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Height="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Margin="3" CornerRadius="10" ClipToBounds="True"
                                        Background="{StaticResource BgCard}"
                                        BorderThickness="2" BorderBrush="Transparent"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="Thumbnail_MouseLeftButtonDown"
                                        MouseMove="Thumbnail_MouseMove"
                                        MouseLeftButtonUp="Thumbnail_MouseLeftButtonUp"
                                        DataContextChanged="Thumbnail_DataContextChanged">
                                    <Grid>
                                        <!-- Miniatura -->
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>

                                        <!-- Placeholder si no hi ha miniatura -->
                                        <Border Background="{StaticResource BgElevated}">
                                            <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="28" Foreground="{StaticResource TextDim}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Opacity="0.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- Indicador de video -->
                                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="#80000000" CornerRadius="24" Padding="10"
                                                Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="18" Foreground="White"/>
                                        </Border>

                                        <!-- Gradient overlay a baix -->
                                        <Border VerticalAlignment="Bottom" Height="36">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="Transparent" Offset="0"/>
                                                    <GradientStop Color="#A0000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Data i localització a baix -->
                                        <StackPanel VerticalAlignment="Bottom" Margin="8,0,8,5">
                                            <TextBlock Text="{Binding DateTaken, StringFormat='dd/MM/yyyy'}"
                                                       FontSize="10" Foreground="#D0FFFFFF"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding DateTaken, Converter={StaticResource NullToVis}}"/>
                                            <TextBlock Text="{Binding Location}"
                                                       FontSize="9" Foreground="#A0FFFFFF"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Location, Converter={StaticResource NullToVis}}"/>
                                        </StackPanel>

                                        <!-- Checkbox de seleccio (top-left, estil modern) -->
                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                                  Margin="6,6,0,0" Opacity="0.85">
                                            <CheckBox.LayoutTransform>
                                                <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                            </CheckBox.LayoutTransform>
                                        </CheckBox>
                                    </Grid>
                                </Border>

                                <!-- Triggers per ressaltat i seleccio -->
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                        <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.9"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{StaticResource AccentLight}"/>
                                        <Setter TargetName="ThumbBorder" Property="BorderThickness" Value="3"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                <!-- Canvas overlay per al rectangle de selecció (rubber band) -->
                <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
                    <Rectangle x:Name="SelectionRectangle"
                               Fill="#30E8935A"
                               Stroke="#E8935A"
                               StrokeThickness="1"
                               RadiusX="2" RadiusY="2"
                               Visibility="Collapsed"/>
                </Canvas>
                </Grid>

                <!-- Vista Timeline (agrupada per data, virtualitzada) -->
                <ListBox Grid.Row="2" Panel.ZIndex="1"
                         ItemsSource="{Binding GroupedPhotos}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.CacheLength="1"
                         VirtualizingPanel.CacheLengthUnit="Page"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Background="{StaticResource BgBase}"
                         BorderThickness="0"
                         Focusable="False"
                         Margin="8"
                         Visibility="{Binding IsTimelineMode, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <!-- Header del grup (clicable per col·lapsar) -->
                                    <Border Background="{StaticResource BgSurface}" CornerRadius="8" Padding="12,8"
                                            Margin="0,0,0,6" Cursor="Hand"
                                            MouseLeftButtonDown="TimelineHeader_Click">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Foreground="{StaticResource TextDim}" FontSize="11"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding Count, Mode=OneWay}"/>
                                                <Run Text="fotos"/>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="10" Foreground="{StaticResource TextDim}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                                           RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="-90"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Key}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- Fotos del grup (WrapPanel) -->
                                    <ItemsControl ItemsSource="{Binding Photos}">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Height="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Margin="3" CornerRadius="10" ClipToBounds="True"
                                                        Background="{StaticResource BgCard}"
                                                        BorderThickness="2" BorderBrush="Transparent"
                                                        Cursor="Hand"
                                                        MouseLeftButtonDown="Thumbnail_MouseLeftButtonDown">
                                                    <Grid>
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <Border VerticalAlignment="Bottom" Height="36">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="Transparent" Offset="0"/>
                                                                    <GradientStop Color="#A0000000" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <TextBlock VerticalAlignment="Bottom" Margin="8,0,8,6"
                                                                   Text="{Binding FileName}" FontSize="10"
                                                                   Foreground="#D0FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                  Margin="6,6,0,0" Opacity="0.85">
                                                            <CheckBox.LayoutTransform>
                                                                <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                                            </CheckBox.LayoutTransform>
                                                        </CheckBox>
                                                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Background="#80000000" CornerRadius="24" Padding="10"
                                                                Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                       FontSize="18" Foreground="White"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                <!-- Missatge benvinguda quan no hi ha fotos -->
                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Photos.Count, Converter={StaticResource ZeroToVis}}">
                    <Border Background="{StaticResource AccentSubtle}" CornerRadius="20" Padding="16"
                            HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="44" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Afegeix una carpeta per veure les imatges"
                               FontSize="18" FontWeight="Light" Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Center" Opacity="0.8"/>
                    <TextBlock Text="o importa fotos des d'un dispositiu MTP"
                               FontSize="13" Foreground="{StaticResource TextDim}"
                               HorizontalAlignment="Center" Margin="0,8,0,24"/>
                    <Button Style="{StaticResource BtnPrimary}"
                            Command="{Binding OpenFolderCommand}"
                            FontSize="14" Padding="28,12"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" FontFamily="Segoe UI Emoji" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Afegir carpeta" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Spinner de carrega -->
                <Border Grid.Row="2" Background="#E0141216"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="240" Height="3"
                                     Foreground="{StaticResource Accent}" Background="{StaticResource BgElevated}"
                                     BorderThickness="0"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondary}"
                                   FontSize="13" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ==================== BARRA D'ACCIONS (dins de la graella) ==================== -->
                <Border Grid.Row="3" Padding="16,10"
                        BorderBrush="{StaticResource Accent}" BorderThickness="0,2,0,0"
                        Visibility="{Binding ShowActionBar, Converter={StaticResource BoolToVis}}">
                    <Border.Background>
                        <SolidColorBrush Color="#1C1A1F" Opacity="0.95"/>
                    </Border.Background>
                    <DockPanel>
                        <!-- Info seleccio -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Border Background="{StaticResource AccentSubtle}" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                <TextBlock Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold">
                                    <Run Text="{Binding SelectedPhotosCount, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                            <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center">
                                <Run Text="seleccionat(s)  ·  "/>
                                <Run Text="{Binding TotalSelectedSizeMB, Mode=OneWay, StringFormat={}{0:N1}}"/>
                                <Run Text=" MB"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Botons d'accio mode LOCAL -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    Visibility="{Binding IsDeviceBrowseMode, Converter={StaticResource InvBoolToVis}}">
                            <!-- Píndola d'avís: amb destí Mirat actiu, Copiar/Moure pugen al núvol -->
                            <Border Background="{StaticResource AccentSubtle}" CornerRadius="10" Padding="8,3"
                                    Margin="0,0,6,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasActiveMiratDestination, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Destí Mirat actiu: «Copiar» puja a Mirat i «Moure» puja i mou el fitxer local a la paperera. Desactiva'l amb la X del capdamunt per tornar a copiar/moure a carpetes.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding ActiveMiratLabel}" FontSize="11" FontWeight="Medium"
                                               Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                               MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Button Command="{Binding CopySelectedCommand}" Margin="4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BtnToolbarIcon}">
                                        <Setter Property="ToolTip" Value="Copiar seleccionats a una altra carpeta"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveMiratDestination}" Value="True">
                                                <Setter Property="ToolTip" Value="Pujar seleccionats a Mirat"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource TextPrimary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE8C8;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveMiratDestination}" Value="True">
                                                    <Setter Property="Text" Value="&#xE753;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Command="{Binding MoveSelectedCommand}" Margin="4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BtnToolbarIcon}">
                                        <Setter Property="ToolTip" Value="Moure seleccionats a una altra carpeta"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveMiratDestination}" Value="True">
                                                <Setter Property="ToolTip" Value="Moure a Mirat: puja els seleccionats i mou el fitxer local a la paperera"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource TextPrimary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE8DE;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveMiratDestination}" Value="True">
                                                    <Setter Property="Text" Value="&#xE898;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource BtnDanger}"
                                    Command="{Binding DeleteSelectedCommand}"
                                    Margin="4,0" Padding="10,8" ToolTip="Eliminar seleccionats (Del)">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                            </Button>
                            <Border Width="1" Background="{StaticResource BorderSubtle}" Margin="10,4" VerticalAlignment="Stretch"/>
                            <Button Style="{StaticResource BtnIcon}"
                                    Command="{Binding DeselectAllCommand}"
                                    ToolTip="Desseleccionar tot" Padding="8,6">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </Button>
                        </StackPanel>

                        <!-- Botons d'accio mode DISPOSITIU -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    Visibility="{Binding IsDeviceBrowseMode, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource BtnPrimary}"
                                    Command="{Binding ImportSelectedFromDeviceCommand}"
                                    Margin="4,0" Padding="12,8" ToolTip="Importar les fotos seleccionades">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Importar" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- Enviar a Mirat directament (sense importar al disc); només si hi ha destí actiu -->
                            <Button Style="{StaticResource BtnPrimary}"
                                    Command="{Binding UploadSelectedDeviceToMiratCommand}"
                                    Margin="4,0" Padding="12,8"
                                    Visibility="{Binding HasActiveMiratDestination, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Enviar les fotos seleccionades a Mirat sense importar-les al disc">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE753;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Enviar a Mirat" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <!-- Eliminar no disponible via MTP/iPhone -->
                            <Border Width="1" Background="{StaticResource BorderSubtle}" Margin="10,4" VerticalAlignment="Stretch"/>
                            <Button Style="{StaticResource BtnIcon}"
                                    Command="{Binding DeselectAllCommand}"
                                    ToolTip="Desseleccionar tot" Padding="8,6">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </Button>
                            <Button Style="{StaticResource BtnIcon}"
                                    Command="{Binding ExitDeviceBrowseModeCommand}"
                                    ToolTip="Sortir del mode dispositiu" Padding="8,6" Margin="4,0,0,0">
                                <TextBlock Text="Desconnectar" FontSize="11"
                                           Foreground="{StaticResource DangerColor}"/>
                            </Button>
                        </StackPanel>

                        <Border/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ==================== SEPARADOR SPLIT ==================== -->
            <GridSplitter x:Name="SplitGridSplitter" Grid.Column="1"
                          Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderSubtle}"
                          Visibility="{Binding IsSplitViewerVisible, Converter={StaticResource BoolToVis}}"
                          Cursor="SizeWE"/>

            <!-- ==================== VISOR LATERAL (mode split) ==================== -->
            <Grid x:Name="SplitViewerPanel" Grid.Column="2"
                  Visibility="{Binding IsSplitViewerVisible, Converter={StaticResource BoolToVis}}"
                  Background="{StaticResource BgBase}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra superior del visor split -->
                <Border Grid.Row="0" Background="{StaticResource BgSurface}" Padding="12,7"
                        BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <!-- Tancar (macOS: xmark) -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcon}"
                                Command="{Binding CloseViewerCommand}" ToolTip="Tancar visor (Esc)" Padding="6,4">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource TextDim}"/>
                        </Button>

                        <!-- Eliminar (macOS: trash) -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcon}"
                                Command="{Binding DeleteCurrentViewerCommand}" ToolTip="Eliminar aquesta foto (Del)" Padding="6,4">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource DangerColor}"/>
                        </Button>

                        <!-- Copiar (macOS: doc.on.doc) -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcon}"
                                Command="{Binding CopyCurrentPhotoCommand}" ToolTip="Copiar la foto al destí (C) — amb un destí Mirat actiu, la puja a Mirat"
                                Padding="6,4" Margin="4,0,0,0">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource TextPrimary}"/>
                        </Button>

                        <!-- Botons de zoom -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,6,0">
                            <Button Style="{StaticResource BtnIcon}"
                                    Command="{Binding ViewerZoomOutCommand}" ToolTip="Reduir (-)" Padding="5,4">
                                <TextBlock Text="&#xE71F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                            </Button>
                            <TextBlock Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" FontSize="10" Margin="2,0"
                                       Text="{Binding ViewerZoom, StringFormat={}{0:P0}}"/>
                            <Button Style="{StaticResource BtnIcon}"
                                    Command="{Binding ViewerZoomInCommand}" ToolTip="Ampliar (+)" Padding="5,4">
                                <TextBlock Text="&#xE71E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                            </Button>
                            <Button Style="{StaticResource BtnIcon}"
                                    Command="{Binding ViewerZoomResetCommand}" ToolTip="Reset zoom (0)"
                                    Padding="5,4">
                                <TextBlock Text="1:1" FontSize="10" Foreground="{StaticResource TextDim}"/>
                            </Button>
                        </StackPanel>

                        <!-- Info imatge -->
                        <TextBlock Text="{Binding ViewerInfoText}"
                                   Foreground="{StaticResource TextDim}"
                                   FontSize="10" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <!-- Imatge al visor split -->
                <Grid Grid.Row="1" ClipToBounds="True"
                      MouseWheel="Viewer_MouseWheel"
                      MouseLeftButtonDown="Viewer_MouseLeftButtonDown"
                      MouseLeftButtonUp="Viewer_MouseLeftButtonUp"
                      MouseMove="Viewer_MouseMove"
                      Background="Transparent">

                    <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                            Style="{StaticResource BtnNav}"
                            Command="{Binding ViewerPreviousCommand}"
                            Width="40" Height="64" Margin="10,0" Panel.ZIndex="10"
                            ToolTip="Anterior">
                        <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="White"/>
                    </Button>

                    <Image x:Name="SplitViewerImageControl"
                           Source="{Binding ViewerImage}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5"
                           Visibility="{Binding IsViewingVideo, Converter={StaticResource InvBoolToVis}}">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding ViewerZoom}" ScaleY="{Binding ViewerZoom}"/>
                                <TranslateTransform X="{Binding ViewerOffsetX}" Y="{Binding ViewerOffsetY}"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>

                    <MediaElement x:Name="SplitVideoPlayer"
                                  LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="{Binding IsViewingVideo, Converter={StaticResource BoolToVis}}"
                                  MediaEnded="VideoPlayer_MediaEnded"/>

                    <!-- Controls de video -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                            Background="#60000000" CornerRadius="12" Padding="4"
                            Visibility="{Binding IsViewingVideo, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SplitVideoPlayBtn" Style="{StaticResource BtnIcon}"
                                    Click="VideoPlay_Click" ToolTip="Play/Pause (Espai)" Padding="8,6">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                           Foreground="White"/>
                            </Button>
                            <Button Style="{StaticResource BtnIcon}"
                                    Click="VideoStop_Click" ToolTip="Stop" Padding="8,6">
                                <TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                           Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource BtnNav}"
                            Command="{Binding ViewerNextCommand}"
                            Width="40" Height="64" Margin="10,0" Panel.ZIndex="10"
                            ToolTip="Seguent">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="White"/>
                    </Button>
                </Grid>

                <!-- Barra inferior del visor split -->
                <Border Grid.Row="2" Background="{StaticResource BgSurface}" Padding="12,5"
                        BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
                    <TextBlock Foreground="{StaticResource TextDim}" FontSize="10" VerticalAlignment="Center"
                               Opacity="0.6">
                        <Run Text="Navegar  |  +/- zoom  |  Espai play  |  Tab mode  |  Esc tancar"/>
                    </TextBlock>
                </Border>
            </Grid>

            <!-- ==================== VISOR D'IMATGES OVERLAY (mode toggle) ==================== -->
            <Grid x:Name="ViewerOverlay" Grid.ColumnSpan="3"
                  Visibility="{Binding IsOverlayViewerVisible, Converter={StaticResource BoolToVis}}"
                  Background="{StaticResource BgOverlay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barra superior del visor overlay -->
                <Border Grid.Row="0" Padding="16,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#C0141216" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <!-- Tancar (macOS: xmark.circle.fill) -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcon}"
                                Command="{Binding CloseViewerCommand}" ToolTip="Tancar (Esc)">
                            <TextBlock Text="&#xEA3A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                       Foreground="#CCFFFFFF"/>
                        </Button>

                        <!-- Eliminar (macOS: trash) -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcon}"
                                Command="{Binding DeleteCurrentViewerCommand}" ToolTip="Eliminar aquesta foto (Del)"
                                Margin="8,0,0,0">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{StaticResource DangerColor}"/>
                        </Button>

                        <!-- Copiar (macOS: doc.on.doc) -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcon}"
                                Command="{Binding CopyCurrentPhotoCommand}" ToolTip="Copiar la foto al destí (C) — amb un destí Mirat actiu, la puja a Mirat"
                                Margin="8,0,0,0">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                       Foreground="White"/>
                        </Button>

                        <!-- Zoom -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0">
                            <Button Style="{StaticResource BtnIcon}"
                                    Command="{Binding ViewerZoomOutCommand}" ToolTip="Reduir (-)">
                                <TextBlock Text="&#xE71F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                           Foreground="White"/>
                            </Button>
                            <TextBlock Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" FontSize="11" Margin="4,0"
                                       Text="{Binding ViewerZoom, StringFormat={}{0:P0}}"/>
                            <Button Style="{StaticResource BtnIcon}"
                                    Command="{Binding ViewerZoomInCommand}" ToolTip="Ampliar (+)">
                                <TextBlock Text="&#xE71E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                           Foreground="White"/>
                            </Button>
                            <Button Style="{StaticResource BtnIcon}"
                                    Command="{Binding ViewerZoomResetCommand}" ToolTip="Reset zoom (0)">
                                <TextBlock Text="1:1" FontSize="11" Foreground="White"/>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="{Binding ViewerInfoText}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Imatge principal overlay -->
                <Grid Grid.Row="1" ClipToBounds="True"
                      MouseWheel="Viewer_MouseWheel"
                      MouseLeftButtonDown="Viewer_MouseLeftButtonDown"
                      MouseLeftButtonUp="Viewer_MouseLeftButtonUp"
                      MouseMove="Viewer_MouseMove"
                      Background="Transparent">

                    <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                            Style="{StaticResource BtnNav}"
                            Command="{Binding ViewerPreviousCommand}"
                            Width="48" Height="80" Margin="16,0" Panel.ZIndex="10"
                            ToolTip="Anterior">
                        <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                   Foreground="White"/>
                    </Button>

                    <Image x:Name="ViewerImageControl"
                           Source="{Binding ViewerImage}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5"
                           Visibility="{Binding IsViewingVideo, Converter={StaticResource InvBoolToVis}}">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding ViewerZoom}" ScaleY="{Binding ViewerZoom}"/>
                                <TranslateTransform X="{Binding ViewerOffsetX}" Y="{Binding ViewerOffsetY}"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>

                    <MediaElement x:Name="OverlayVideoPlayer"
                                  LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="{Binding IsViewingVideo, Converter={StaticResource BoolToVis}}"
                                  MediaEnded="VideoPlayer_MediaEnded"/>

                    <!-- Controls de video overlay -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                            Background="#60000000" CornerRadius="14" Padding="6"
                            Visibility="{Binding IsViewingVideo, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="OverlayVideoPlayBtn" Style="{StaticResource BtnIcon}"
                                    Click="VideoPlay_Click" ToolTip="Play/Pause (Espai)" Padding="10,8">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                           Foreground="White"/>
                            </Button>
                            <Button Style="{StaticResource BtnIcon}"
                                    Click="VideoStop_Click" ToolTip="Stop" Padding="10,8">
                                <TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                           Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource BtnNav}"
                            Command="{Binding ViewerNextCommand}"
                            Width="48" Height="80" Margin="16,0" Panel.ZIndex="10"
                            ToolTip="Seguent">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                   Foreground="White"/>
                    </Button>
                </Grid>

                <!-- Barra inferior del visor overlay -->
                <Border Grid.Row="2" Padding="16,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Color="#C0141216" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center"
                               Opacity="0.6" HorizontalAlignment="Center">
                        <Run Text="Navegar  |  +/- zoom  |  Tab mode  |  Esc tancar"/>
                    </TextBlock>
                </Border>
            </Grid>

            <!-- ==================== PANELL DISK SCANNER ==================== -->
            <Border Grid.ColumnSpan="3"
                    HorizontalAlignment="Right" Width="360"
                    Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowDiskScanPanel, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource BgElevated}" Padding="16,12"
                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcon}"
                                    Command="{Binding ToggleDiskScanPanelCommand}" Padding="6">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="12" Foreground="{StaticResource TextDim}"/>
                            </Button>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="16" Foreground="{StaticResource Accent}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Escanejar disc" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Padding="12,8"
                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding DiskScanStatus}" FontSize="10"
                                       Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource BtnIcon}" Padding="8,4"
                                        Command="{Binding SelectAllDiskScanResultsCommand}"
                                        Margin="0,0,6,0">
                                    <TextBlock Text="Sel. tot" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                </Button>
                                <Button Style="{StaticResource BtnToolbar}" Padding="12,6"
                                        Command="{Binding AddSelectedDiskScanResultsCommand}">
                                    <TextBlock Text="Afegir seleccionades" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                        <StackPanel>
                            <!-- Botons d'escaneig -->
                            <StackPanel Orientation="Horizontal" Margin="8,8,8,12">
                                <Button Style="{StaticResource BtnPrimary}" Padding="12,6"
                                        Command="{Binding StartDiskScanCommand}"
                                        Visibility="{Binding IsScanningDisk, Converter={StaticResource InvBoolToVis}}">
                                    <TextBlock Text="Escanejar" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource BtnIcon}" Padding="8,6" Margin="6,0,0,0"
                                        Command="{Binding StopDiskScanCommand}"
                                        Visibility="{Binding IsScanningDisk, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Aturar" FontSize="10" Foreground="{StaticResource DangerColor}"/>
                                </Button>
                            </StackPanel>

                            <!-- Llista de resultats -->
                            <ItemsControl ItemsSource="{Binding DiskScanResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,5" Margin="0,0,0,2"
                                                Background="{StaticResource BgCard}" CornerRadius="6">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}"
                                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Foreground="{StaticResource TextDim}" FontSize="10"
                                                           VerticalAlignment="Center">
                                                    <Run Text="{Binding FileCount, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding FolderPath}" FontSize="10"
                                                           Foreground="{StaticResource TextSecondary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FolderPath}"
                                                           VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ==================== PANELL D'IMPORTACIO ==================== -->
            <Border x:Name="ImportPanel" Grid.ColumnSpan="3"
                    HorizontalAlignment="Right" Width="360"
                    Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsImportPanelOpen, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <!-- Capçalera -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource BgElevated}" Padding="16,12"
                            BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcon}"
                                    Command="{Binding ToggleImportPanelCommand}" Padding="6,4">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource TextDim}"/>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Importar des del dispositiu" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Contingut -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <!-- Estat: Cercant dispositius -->
                            <StackPanel Visibility="{Binding IsBrowsingDevice, Converter={StaticResource BoolToVis}}"
                                        Margin="0,20,0,20" HorizontalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Height="3"
                                             Foreground="{StaticResource Accent}"
                                             Background="{StaticResource BgElevated}" BorderThickness="0"
                                             Width="200" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding ImportStatusMessage}"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Estat: Sense dispositius / Llista de dispositius -->
                            <StackPanel Visibility="{Binding IsBrowsingDevice, Converter={StaticResource InvBoolToVis}}">
                                <!-- Botó detectar -->
                                <Button Content="Detectar dispositius" Style="{StaticResource BtnPrimary}"
                                        Command="{Binding DetectDevicesCommand}"
                                        HorizontalAlignment="Stretch" Margin="0,4,0,12"
                                        Padding="14,10"/>

                                <!-- Llista de dispositius -->
                                <ItemsControl ItemsSource="{Binding Devices}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgElevated}" CornerRadius="8"
                                                    Padding="12,10" Margin="0,0,0,4" Cursor="Hand"
                                                    MouseLeftButtonDown="DeviceItem_Click">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left"
                                                               Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                               Foreground="{StaticResource Accent}"
                                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding FriendlyName}"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               FontSize="12" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Botó navegar fotos (visible si hi ha dispositiu seleccionat) -->
                                <Button Style="{StaticResource BtnPrimary}"
                                        Command="{Binding BrowseDeviceCommand}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,12"
                                        Padding="14,10"
                                        Visibility="{Binding SelectedDevice, Converter={StaticResource NullToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Navegar fotos" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Missatge d'estat -->
                                <TextBlock Text="{Binding ImportStatusMessage}"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                <!-- Progrés d'importació -->
                                <ProgressBar Value="{Binding ImportProgress}" Minimum="0" Maximum="100"
                                             Height="3" Foreground="{StaticResource Accent}"
                                             Background="{StaticResource BgElevated}" BorderThickness="0"
                                             Margin="0,8,0,4"
                                             Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}"/>

                                <!-- Instruccions -->
                                <Border Background="{StaticResource BgElevated}" CornerRadius="10"
                                        Padding="14,12" Margin="0,20,0,0"
                                        BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                                    <TextBlock Foreground="{StaticResource TextDim}" FontSize="11"
                                               TextWrapping="Wrap" LineHeight="20">
                                        1. Connecta l'iPhone via USB i desbloqueja'l.
                                        <LineBreak/>
                                        2. Prem "Confiar" a l'iPhone.
                                        <LineBreak/>
                                        3. Prem "Detectar dispositius".
                                        <LineBreak/>
                                        4. Prem "Navegar fotos" per veure-les a la graella.
                                        <LineBreak/>
                                        5. Selecciona les fotos i importa-les.
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ==================== TOAST UNDO DELETE ==================== -->
        <!-- Flotant per sobre de tot (inclòs el visor overlay). Es col·loca al Grid arrel
             amb Grid.Row="1" i Panel.ZIndex alt perquè mai quedi tapat per l'overlay. -->
        <Border Grid.Row="1" Panel.ZIndex="1000"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24" Padding="14,10"
                CornerRadius="10"
                Background="#E6000000"
                BorderBrush="{StaticResource BorderMedium}" BorderThickness="1"
                Visibility="{Binding CanUndoDelete, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="14" Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding UndoToastMessage}" FontSize="12"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Style="{StaticResource BtnIcon}" Padding="10,5" Margin="0,0,6,0"
                        Command="{Binding UndoLastDeleteCommand}"
                        ToolTip="Desfer (Ctrl+Z)">
                    <TextBlock Text="Desfer" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}"/>
                </Button>
                <Button Style="{StaticResource BtnIcon}" Padding="6,5"
                        Command="{Binding DismissUndoToastCommand}"
                        ToolTip="Descartar">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="11" Foreground="{StaticResource TextDim}"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ==================== BARRA D'ESTAT ==================== -->
        <Border Grid.Row="2" Background="{StaticResource BgSurface}" Padding="16,6"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Value="{Binding CopyProgress}"
                             Minimum="0" Maximum="100" Width="120" Height="3"
                             Foreground="{StaticResource Accent}" Background="{StaticResource BgElevated}"
                             BorderThickness="0" VerticalAlignment="Center" Margin="8,0,0,0"
                             Visibility="{Binding IsCopying, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerColor}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- ==================== OVERLAY D'AJUDA (F1): dreceres i gestos ==================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="2000"
              Visibility="{Binding IsHelpOverlayVisible, Converter={StaticResource BoolToVis}}">
            <Grid.Resources>
                <Style x:Key="HelpKeyBox" TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource BgElevated}"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="Padding" Value="6,1"/>
                    <Setter Property="MinWidth" Value="86"/>
                    <Setter Property="Margin" Value="0,0,8,0"/>
                    <Setter Property="VerticalAlignment" Value="Top"/>
                </Style>
                <Style x:Key="HelpKeyText" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Consolas"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                </Style>
                <Style x:Key="HelpDesc" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11.5"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="MaxWidth" Value="230"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
                <Style x:Key="HelpSectionTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="10"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                    <Setter Property="Margin" Value="0,0,0,7"/>
                </Style>
                <Style x:Key="HelpRow" TargetType="StackPanel">
                    <Setter Property="Orientation" Value="Horizontal"/>
                    <Setter Property="Margin" Value="0,0,0,5"/>
                </Style>
            </Grid.Resources>

            <!-- Fons translúcid: clic fora tanca -->
            <Border Background="#CC121014" MouseLeftButtonDown="HelpBackdrop_MouseDown"/>

            <Border MaxWidth="760" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="12" Padding="28,22">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcon}" Padding="6,4"
                                Command="{Binding ToggleHelpOverlayCommand}" ToolTip="Tancar (Esc)">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12" Foreground="{StaticResource TextDim}"/>
                        </Button>
                        <TextBlock Text="Dreceres i gestos" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Columna esquerra: General + Visor -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="GENERAL" Style="{StaticResource HelpSectionTitle}"/>
                            <StackPanel Style="{StaticResource HelpRow}">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="Ctrl+O"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="Afegir una carpeta (se suma a les obertes)"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HelpRow}">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="Ctrl+A / D"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="Seleccionar-ho tot / desseleccionar"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HelpRow}">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="Ctrl+Z"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="Desfer l'últim esborrat"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HelpRow}">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="Tab / F5"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="Visor lateral ↔ superposat"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HelpRow}">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="Supr"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="Eliminar la selecció (a la paperera)"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HelpRow}" Margin="0,0,0,14">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="F1"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="Aquest full d'ajuda"/>
                            </StackPanel>

                            <TextBlock Text="VISOR" Style="{StaticResource HelpSectionTitle}"/>
                            <StackPanel Style="{StaticResource HelpRow}">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="←  →"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="Foto anterior / següent"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HelpRow}">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="+  −  0"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="Apropar · allunyar · zoom 100%"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HelpRow}">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="F"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="Ajustar a la pantalla"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HelpRow}">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="C"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="Copiar la foto al destí (o pujar-la a Mirat)"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HelpRow}">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="Espai"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="Vídeo: reproduir / pausar"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HelpRow}">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="Esc"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="Tancar el visor"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Columna dreta: Ratolí + Bo de saber -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="RATOLÍ I GESTOS" Style="{StaticResource HelpSectionTitle}"/>
                            <StackPanel Style="{StaticResource HelpRow}">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="clic"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="Obre la foto al visor"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HelpRow}">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="Ctrl/Maj+clic"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="Selecció individual / per interval"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HelpRow}">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="arrossegar"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="En zona buida: selecció per rectangle"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HelpRow}">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="arrossegar"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="Miniatures cap a l'Explorador o el correu: copia els fitxers"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HelpRow}">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="roda"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="Al visor: zoom centrat al cursor"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HelpRow}">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="arrossegar"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="Al visor amb zoom: moure's per la foto"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HelpRow}">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="doble clic"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="Tanca el visor superposat"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource HelpRow}" Margin="0,0,0,14">
                                <Border Style="{StaticResource HelpKeyBox}"><TextBlock Style="{StaticResource HelpKeyText}" Text="clic dret"/></Border>
                                <TextBlock Style="{StaticResource HelpDesc}" Text="Desselecciona-ho tot"/>
                            </StackPanel>

                            <TextBlock Text="BO DE SABER" Style="{StaticResource HelpSectionTitle}"/>
                            <TextBlock Style="{StaticResource HelpDesc}" MaxWidth="330" Margin="0,0,0,5"
                                       Text="· Amb un destí Mirat actiu, «Copiar» i «Moure» pugen les fotos a Mirat («Moure» esborra el local després de pujar)."/>
                            <TextBlock Style="{StaticResource HelpDesc}" MaxWidth="330" Margin="0,0,0,5"
                                       Text="· iPhone: connecta'l per USB, desbloqueja'l i prem «Confiar»."/>
                            <TextBlock Style="{StaticResource HelpDesc}" MaxWidth="330"
                                       Text="· Del dispositiu es carreguen només els mesos recents; amplia amb «+ Mes anterior»."/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,16,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Guia completa (importar, Mirat, duplicats, problemes):"
                                   FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource BtnIcon}" Padding="2,0"
                                Command="{Binding OpenHelpGuideCommand}"
                                ToolTip="Obre la guia al navegador">
                            <TextBlock Text="miratfotos.com/ajuda/photo-manager" FontSize="11"
                                       Foreground="{StaticResource Accent}" TextDecorations="Underline"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
